# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.

# Groq API key for the AI analysis layer — https://console.groq.com/keys
# Leave blank to run in mock mode.
GROQ_API_KEY=

# MOCK_LLM=true  -> offline canned analysis, no key/internet needed (safe default).
# MOCK_LLM=false -> call the real Groq LLM (needs GROQ_API_KEY + a backend rebuild).
MOCK_LLM=true

# Groq model id — Groq rotates these; see https://console.groq.com/docs/models
LLM_MODEL=llama-3.3-70b-versatile
